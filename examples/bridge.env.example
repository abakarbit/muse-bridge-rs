# muse-bridge-rs configuration — copy to your deployment dir as bridge.env
# (or export in your shell / systemd EnvironmentFile). All values optional.

# SQLite queue database (default: ~/workspace/muse-bridge-rs/bridge.db)
BRIDGE_DB=/home/you/muse-bridge/bridge.db

# Listen port, loopback bind (default: 8765)
BRIDGE_PORT=8765

# Worker lease / long-poll tuning (defaults shown)
BRIDGE_LEASE_SECS=180
BRIDGE_WAIT_SECS=240
BRIDGE_MAX_PENDING=5
BRIDGE_PENDING_TTL_SECS=1800
BRIDGE_FAILED_TTL_SECS=86400

# Optional HTTPS via rustls — set BOTH to enable
# BRIDGE_TLS_CERT=/home/you/muse-bridge/tls/cert.pem
# BRIDGE_TLS_KEY=/home/you/muse-bridge/tls/key.pem
